# Copy to .env and fill in real values: cp .env.example .env
# .env is git-ignored. In staging/production set these as real environment
# variables instead (systemd, Docker, Kubernetes) — there is no .env file there.

# Required. The API refuses to start without it.
APP_DB_DSN=postgres://app:pa55word@localhost/app?sslmode=disable

APP_PORT=4000
APP_ENV=development

APP_SMTP_HOST=sandbox.smtp.mailtrap.io
APP_SMTP_PORT=2525
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_SENDER=App <no-reply@example.com>

# Origins allowed to call the API from a browser, space separated, e.g.
# APP_CORS_TRUSTED_ORIGINS=http://localhost:3000 https://app.example.com
APP_CORS_TRUSTED_ORIGINS=
