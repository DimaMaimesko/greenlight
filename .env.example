# Copy to .env and fill in real values: cp .env.example .env
# .env is git-ignored. In staging/production set these as real environment
# variables instead (systemd, Docker, Kubernetes) — there is no .env file there.

# Required. The API refuses to start without it.
GREENLIGHT_DB_DSN=postgres://greenlight:pa55word@localhost/greenlight?sslmode=disable

GREENLIGHT_PORT=4000
GREENLIGHT_ENV=development

GREENLIGHT_SMTP_HOST=sandbox.smtp.mailtrap.io
GREENLIGHT_SMTP_PORT=2525
GREENLIGHT_SMTP_USERNAME=
GREENLIGHT_SMTP_PASSWORD=
GREENLIGHT_SMTP_SENDER=Greenlight <no-reply@dima.maimesko.com>

# Space separated.
GREENLIGHT_CORS_TRUSTED_ORIGINS=https://editor.swagger.io
